[Unit]
Description=MindTrail web
After=network-online.target studyforge-backend.service
Wants=network-online.target studyforge-backend.service

[Service]
Type=simple
User=studyforge
Group=studyforge
WorkingDirectory=/opt/studyforge/current/frontend
EnvironmentFile=/etc/studyforge/frontend.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/studyforge/current/frontend/.next/cache

[Install]
WantedBy=multi-user.target
